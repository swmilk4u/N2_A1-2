# ==============================================================================
# Travel Planner API Keys Configuration Template
# 복사하여 .env 파일을 생성하고 실제 키 값을 입력해 주세요.
# (.env 파일은 절대 Git에 커밋하거나 외부로 유출해서는 안 됩니다.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Keys (최소 하나 이상 설정 필요)
# ------------------------------------------------------------------------------
# OpenAI API Key (예: sk-proj-...)
OPENAI_API_KEY=

# Google Gemini API Key (예: AIzaSy...)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Local/Map API Keys (최소 하나 이상 설정 필요)
# ------------------------------------------------------------------------------
# Kakao REST API Key (로컬 API 사용 목적)
KAKAO_API_KEY=

# Naver Client ID & Client Secret (지역 검색 API 사용 목적)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
